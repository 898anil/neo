# Slack bot token (xoxb-...), from: App Settings -> OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-...

# Slack app-level token (xapp-...), scope connections:write, from:
# App Settings -> Basic Information -> App-Level Tokens (needed for Socket Mode)
SLACK_APP_TOKEN=xapp-...

# Comma-separated Slack user ids allowed to trigger the bot. REQUIRED in a
# shared workspace -- a trigger runs an agent on this machine with tool access.
ALLOWED_USER_IDS=U0XXXXXXX

# Engine used when a message does not name one: claude | codex
# NEO_DEFAULT_ENGINE=codex

# Headless permission level: readonly | edit | full (default full: no approval prompts,
# which is how the bot has always run). Live (herdr) runs use each CLI's own settings.
# NEO_MODE=full

# Folder agents work in unless a message says cwd=<path>. Falls back to
# CODEX_WORKDIR, then CLAUDE_WORKDIR, then your home directory.
# NEO_WORKDIR=/Users/you/Documents/projects

# Dashboard with every run's full timeline. Set a port to serve it from the bot.
# NEO_DASHBOARD_PORT=8788
# NEO_DASHBOARD_HOST=127.0.0.1       # 0.0.0.0 to reach it over Tailscale; then also set COS_TOKEN
# NEO_DASHBOARD_URL=http://mac-mini:8788   # link posted in Slack, if different from host:port
# COS_TOKEN=                          # require ?token=... on the dashboard

# herdr session used for live runs (kept separate from your own default session).
# NEO_HERDR_SESSION=neo

# Optional executable paths, for process managers whose PATH differs from your shell.
# CLAUDE_CLI_PATH=/Users/you/.local/bin/claude
# CODEX_CLI_PATH=/Users/you/.nvm/versions/node/v24/bin/codex
# HERDR_CLI_PATH=/Users/you/.local/bin/herdr

# Optional model overrides. Omit to use each CLI's configured default.
# CLAUDE_MODEL=
# CODEX_MODEL=

# ---- Who neo works for (used in the prompts it writes; read on every run)
# Your name as prompts should say it. Default: "the owner".
# NEO_OWNER_NAME=Alex
# Optional one-line description added after the name, e.g. in the morning brief and mentions check.
# NEO_OWNER_PROFILE=an engineer at Acme
# Your Slack user id: notifications go to it (default: the first ALLOWED_USER_IDS), and the mentions
# check (Slack messages tagging you, with drafted replies) runs only when it is set.
# NEO_NOTIFY_USER=U0XXXXXXX

# Standing instructions for every agent (default: prompts/slack-agent.md). Point this at your own file
# to keep company-specific rules (approvals, reviewers, deploy steps) out of the repo.
# NEO_BRIEF_FILE=/Users/you/neo-private/brief.md

# Extra rules for the Slack mentions check, appended to its rule list. One rule per line; a literal \n
# also separates rules. Default: none.
# NEO_MENTIONS_RULES=I do not review PRs.

# What this Slack app is called, so the mentions check and the brief skip neo's own posts. Set at
# startup from Slack's auth.test; set it here only to override.
# NEO_BOT_NAME=nio

# ---- Memory (cos/learn.py): Markdown notes neo learns from mistakes and from what you tell it
# NEO_MEMORY_DIR=~/.neo/memory

# ---- Your infrastructure (built-in watches and follow-ups; unset = generic or off)
# GCP project the "Production errors" watch reads with `gcloud logging`. Unset: that watch starts off.
# Only used when watches.json is first created; edit existing watches on the Work tab.
# NEO_GCP_PROD_PROJECT=acme-prod
# GitHub organisation whose repositories the "CI on main" watch checks. Unset: repos under NEO_WORKDIR.
# NEO_GITHUB_ORG=acme
# Repo whose workflows deploy to production, used by the loop follow-up check to tell "deployed".
# "name" (same owner as the PR) or "owner/name". Unset: the check finds the deploy itself.
# NEO_DEPLOY_REPO=acme-deploy

# ---- Install (deploy/install.sh)
# launchd label of the agent. Default com.neo.slack-bot. Keep it stable: a new label is a second agent.
# NEO_LAUNCHD_LABEL=com.neo.slack-bot
# A specific tailscale CLI binary, if not the one on PATH.
# TAILSCALE_BIN=/usr/local/bin/tailscale
# Python for the neo-logs wrapper (default: .venv, then the Poetry environment).
# NEO_PYTHON=
