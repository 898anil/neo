{
  "display_information": {
    "name": "Neo",
    "description": "Your chief of staff: runs coding agents for you, watches what matters, and sends you a morning brief.",
    "background_color": "#1f1f1f"
  },
  "features": {
    "bot_user": {
      "display_name": "neo",
      "always_online": true
    },
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "chat:write.customize",
        "reactions:write",
        "channels:history",
        "groups:history",
        "im:history",
        "files:read",
        "files:write",
        "users:read",
        "users:read.email"
      ],
      "user": [
        "search:read",
        "channels:history",
        "groups:history",
        "channels:read",
        "groups:read",
        "files:read",
        "users:read"
      ]
    },
    "redirect_urls": [
      "https://spark-8a42.tailaf473.ts.net:8443/slack/oauth"
    ]
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.im",
        "message.channels",
        "message.groups",
        "app_home_opened"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
