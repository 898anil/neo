#!/usr/bin/python3 -I
"""Start one agent turn as a person's own account (neo-<name>); installed root-owned as /usr/local/bin/neo-run.

neo (the service account) runs it through sudo, which the sudoers rule allows only for accounts in the
neo-people group:

    sudo -n -C <fd+1> -u neo-ajay /usr/local/bin/neo-run --spec-fd <fd>

sudo clears the environment and closes other files, so everything the turn needs comes as one JSON
spec on that pipe, never on the command line or on disk:

    argv      the engine command (claude or codex, or `gh auth login|status|logout` to sign the
              account in to GitHub); "{file:NAME}" in it becomes the path of files[NAME]
    cwd       folder inside this account's home ("" for ~/code)
    env       variables for the engine (run id, Slack thread, model); a few names are refused
    files     {NAME: text} written to a private folder for this turn (the system prompt)
    shared    the owner's logins, used only for what this account has not logged in to itself:
              claude_token, gh_token, openai_key
    git_name, git_email   commit identity when this account has none of its own
    tty       true for a live agent in a herdr pane (cos/interactive.py), started with `exec` so no shell of
              neo's is left in it: the engine gets its own process group, in the pane's session, and the
              terminal (keys, resizes, Ctrl-C reach it alone; herdr sees it as the pane's foreground job)
    mirror    {"fd": N, "engine": "claude"|"codex", "session_id": "..."}: copy the engine's own transcript
              (~/.claude/projects, ~/.codex/sessions, which neo can't read) as it grows onto fd N, a file
              neo opened for appending, so neo's watcher can follow the session without reading this home.
              Regular files only, read in bounded chunks, at most MIRROR_MAX bytes per run
    log_fd    N: neo-run's own messages also go there (the pane closes with neo-run, taking them with it)

stdin, stdout and stderr pass straight through to the engine (neo's run files, or the pane's terminal).
A SIGTERM from neo (relayed by sudo) stops the engine's whole process group, with SIGKILL 10 seconds
later if needed.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import pwd
import re
import shutil
import signal
import stat
import subprocess
import sys
import threading
import time
from pathlib import Path

ENGINES = ("claude", "codex")
SIGN_INS = {  # other tools only sign the account in or out, exactly as neo asks (cos/logins.py ARGV)
    "gh": (("auth", "login", "--hostname", "github.com", "--git-protocol", "https", "--web"),
           ("auth", "status", "--hostname", "github.com"),
           ("auth", "logout", "--hostname", "github.com")),
    "gcloud": (("auth", "login", "--no-launch-browser", "--update-adc"),
               ("auth", "revoke", "--all", "--quiet"),
               ("auth", "list", "--filter=status:ACTIVE", "--format=value(account)")),
    "doppler": (("login", "--yes", "--no-check-version"),
                ("logout", "--yes", "--no-check-version"),
                ("me", "--no-check-version"),
                ("configure", "get", "token", "--plain", "--no-check-version")),
}
PATH = "/usr/local/bin:/usr/bin:/bin"
REFUSED_ENV = ("PATH", "HOME", "USER", "LOGNAME", "SHELL", "BASH_ENV", "ENV", "IFS")
KILL_AFTER = 10  # seconds between SIGTERM and SIGKILL
REFUSED_PREFIXES = ("LD_", "PYTHON", "NODE_OPTIONS", "GIT_CONFIG", "SUDO_")


LOG: list = []  # a live agent's log fd (spec "log_fd"): its pane may close before anyone reads it


def say(message: str) -> None:
    line = f"neo-run: {message}"
    print(line, file=sys.stderr)
    sys.stderr.flush()
    for fd in LOG:
        try:
            os.write(fd, (line + "\n").encode())
        except OSError:
            pass


def fail(message: str) -> "None":
    say(message)
    sys.exit(2)


def read_spec(fd: int) -> dict:
    with os.fdopen(fd, "rb") as fh:
        spec = json.loads(fh.read().decode("utf-8"))
    if not isinstance(spec, dict) or not isinstance(spec.get("argv"), list) or not spec["argv"]:
        fail("spec needs a non-empty argv")
    return spec


def account_home() -> Path:
    me = pwd.getpwuid(os.getuid())
    if os.getuid() == 0 or not me.pw_name.startswith("neo-"):
        fail(f"refusing to run as {me.pw_name}: only neo-<name> accounts")
    return Path(me.pw_dir)


def resolve_cwd(home: Path, cwd: str) -> Path:
    """The folder inside this account's home; ~/code when not given."""
    target = Path(cwd).expanduser() if cwd else home / "code"
    if not target.is_absolute():
        target = home / "code" / target
    real, home = Path(os.path.realpath(target)), Path(os.path.realpath(home))
    if real != home and home not in real.parents:
        fail(f"folder is outside {home}: {cwd}")
    return real


def engine_path(name: str, args: list = ()) -> str:
    if tuple(args) in SIGN_INS.get(name, ()):
        pass
    elif name not in ENGINES:
        fail(f"not an engine: {name}")
    found = shutil.which(name, path=PATH)
    if not found:
        fail(f"{name} is not installed in {PATH}")
    return found


def clean_env(given: dict) -> dict:
    out = {}
    for key, value in (given or {}).items():
        key, value = str(key), str(value)
        if key in REFUSED_ENV or key.startswith(REFUSED_PREFIXES) or "=" in key or not key:
            continue
        out[key] = value
    return out


def own_logins(home: Path) -> dict:
    """Which tools this account has logged in to itself."""
    return {
        "claude": (home / ".claude" / ".credentials.json").is_file(),
        "gh": (home / ".config" / "gh" / "hosts.yml").is_file(),
        "codex": (home / ".codex" / "auth.json").is_file(),
    }


TOKEN_NAME = re.compile(r"^[A-Z][A-Z0-9_]{2,40}$")


def token_env(tokens) -> dict:
    """The person's own tool tokens (SENTRY_AUTH_TOKEN, ...), as the tools expect them; odd names are refused."""
    out = {}
    for name, value in (tokens or {}).items():
        name, value = str(name), str(value)
        if TOKEN_NAME.match(name) and name not in REFUSED_ENV and not name.startswith(REFUSED_PREFIXES) and value:
            out[name] = value
    return out


def login_env(home: Path, shared: dict) -> tuple[dict, dict]:
    """Variables that give the engine the owner's logins for what this account lacks, and which login
    each tool ends up with ("own", "shared" or "none")."""
    own, env, used = own_logins(home), {}, {}
    shared = shared or {}
    for tool, key, var in (("claude", "claude_token", "CLAUDE_CODE_OAUTH_TOKEN"),
                           ("gh", "gh_token", "GH_TOKEN"),
                           ("codex", "openai_key", "OPENAI_API_KEY")):
        if own[tool]:
            used[tool] = "own"
        elif shared.get(key):
            env[var] = str(shared[key])
            used[tool] = "shared"
        else:
            used[tool] = "none"
    if used["gh"] == "shared":  # git over https uses the same token through gh
        env.update({"GIT_CONFIG_COUNT": "2",
                    "GIT_CONFIG_KEY_0": "credential.https://github.com.helper", "GIT_CONFIG_VALUE_0": "",
                    "GIT_CONFIG_KEY_1": "credential.https://github.com.helper",
                    "GIT_CONFIG_VALUE_1": "!" + (shutil.which("gh", path=PATH) or "gh") + " auth git-credential"})
    return env, used


def git_identity_env(home: Path, name: str, email: str) -> dict:
    """The person's name on commits, when this account has no git identity of its own."""
    if (home / ".gitconfig").is_file() and "name" in (home / ".gitconfig").read_text(errors="replace"):
        return {}
    env = {}
    if name:
        env["GIT_AUTHOR_NAME"] = env["GIT_COMMITTER_NAME"] = name
    if email:
        env["GIT_AUTHOR_EMAIL"] = env["GIT_COMMITTER_EMAIL"] = email
    return env


STALE_SECONDS = 86400  # a folder with no owner recorded is left this long


def alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except OSError:
        return True  # it exists, as someone else
    return True


def sweep(root: Path, now: float) -> None:
    """Remove turn folders whose neo-run is gone without cleaning up: closing a live agent's herdr pane
    kills the whole job at once (SIGKILL), so its folder is never removed by the neo-run that made it."""
    try:
        folders = list(root.iterdir())
    except OSError:
        return
    for folder in folders:
        if not folder.is_dir() or folder.is_symlink():
            continue
        try:
            owner = int((folder / ".pid").read_text().strip())
            gone = not alive(owner)
        except (OSError, ValueError):
            try:
                gone = now - folder.stat().st_mtime > STALE_SECONDS
            except OSError:
                gone = False
        if gone:
            shutil.rmtree(folder, ignore_errors=True)


def write_files(home: Path, run_id: str, files: dict) -> tuple[Path, dict]:
    """files into ~/.neo-run/<run id>/ (0700); returns the folder and NAME -> path."""
    safe_id = "".join(c for c in run_id if c.isalnum() or c in "-_") or "run"
    sweep(home / ".neo-run", time.time())
    folder = home / ".neo-run" / safe_id
    folder.mkdir(parents=True, exist_ok=True, mode=0o700)
    (folder / ".pid").write_text(str(os.getpid()))  # whose folder this is, for sweep()
    paths = {}
    for name, text in (files or {}).items():
        if "/" in name or name.startswith("."):
            fail(f"bad file name: {name}")
        path = folder / name
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as fh:
            fh.write(str(text))
        paths[name] = str(path)
    return folder, paths


TERM_RE = re.compile(r"^[A-Za-z0-9._+-]{1,64}$")
SESSION_RE = re.compile(r"^[A-Za-z0-9_-]{1,80}$")
MIRROR_SECONDS = 0.5
MIRROR_CHUNK = 1 << 20  # bytes per read
MIRROR_MAX = 256 << 20  # bytes per run: the account writes the transcript, so it can't make neo's copy endless
FIRST_LINE_MAX = 64 << 10
CLAUDE_JSON_MAX = 16 << 20


def tty_env() -> dict:
    """A live agent draws a TUI: it needs the terminal type sudo kept for us."""
    term = os.environ.get("TERM", "")
    env = {"TERM": term if TERM_RE.match(term) else "xterm-256color"}
    if TERM_RE.match(os.environ.get("COLORTERM", "")):
        env["COLORTERM"] = os.environ["COLORTERM"]
    return env


def claude_running() -> bool:
    """Whether a Claude of this account is running now (it rewrites ~/.claude.json as it goes)."""
    me = os.getuid()
    for entry in os.scandir("/proc"):
        if not entry.name.isdigit() or int(entry.name) == os.getpid():
            continue
        try:
            if entry.stat().st_uid == me and Path(entry.path, "comm").read_text().strip() == "claude":
                return True
        except OSError:
            continue
    return False


def prepare_live_claude(home: Path) -> None:
    """A live Claude in an account that never ran one would sit on its first-run screen (pick a theme),
    which nobody is there to answer. Answer it once. Never rewrites the file under a running Claude, which
    rewrites it itself; a choice the person already made is kept. (Bypass-permissions mode's warning is
    answered per run, in neo's --settings, not in the person's own settings.)"""
    path, defaults = home / ".claude.json", {"hasCompletedOnboarding": True, "theme": "dark"}
    text = json.dumps(defaults, indent=2) + "\n"
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    except FileExistsError:
        pass
    except OSError:
        return
    else:
        with os.fdopen(fd, "w") as fh:
            fh.write(text)
        return
    try:
        data = json.loads(read_regular(path, 0, CLAUDE_JSON_MAX) or b"")
    except ValueError:
        return  # not ours to fix: leave it to the person
    if not isinstance(data, dict) or data.get("hasCompletedOnboarding") or claude_running():
        return
    tmp = path.with_name(f".{path.name}.neo-run.{os.getpid()}")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(json.dumps({**defaults, **data, "hasCompletedOnboarding": True}, indent=2) + "\n")
    os.replace(tmp, path)


def read_regular(path, offset: int, size: int):
    """Up to size bytes of path from offset; None unless it is a regular file (never a link, a FIFO or a
    device the account put there to stall or flood neo-run)."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        return os.pread(fd, size, offset)
    except OSError:
        return None
    finally:
        os.close(fd)


def started_at(first: dict):
    """When a Codex rollout's session started (its session_meta), as epoch seconds."""
    from datetime import datetime
    for value in ((first.get("payload") or {}).get("timestamp"), first.get("timestamp")):
        try:
            return datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp()
        except ValueError:
            continue
    return None


def claimed_rollouts(root: Path, mine: Path) -> set:
    """Rollouts other live neo-runs of this account already mirror (their folder's .claim)."""
    out = set()
    try:
        folders = list(root.iterdir())
    except OSError:
        return out
    for folder in folders:
        if folder == mine or not folder.is_dir() or folder.is_symlink():
            continue
        try:
            if alive(int((folder / ".pid").read_text().strip())):
                out.add((folder / ".claim").read_text().strip())
        except (OSError, ValueError):
            continue
    return out


def find_transcript(home: Path, engine: str, session_id: str, cwd: Path, since: float, folder=None):
    """The engine's transcript for this session: Claude's by its id; Codex's by its id, else (Codex has no
    way to name a new session) the first rollout in this folder that started after the engine did and that
    no other live run of this account has claimed; the claim goes in folder/.claim."""
    if session_id and not SESSION_RE.match(session_id):
        return None
    if engine == "claude" and session_id:
        found = sorted((home / ".claude" / "projects").glob(f"*/{session_id}.jsonl"))
        return found[0] if found else None
    if engine != "codex":
        return None
    rollouts = list((home / ".codex" / "sessions").glob("*/*/*/rollout-*.jsonl"))
    if session_id:
        return next((p for p in rollouts if p.name.endswith(f"{session_id}.jsonl")), None)
    fresh = []
    for path in rollouts:
        try:
            if path.lstat().st_mtime < since - 5:
                continue
            first = json.loads((read_regular(path, 0, FIRST_LINE_MAX) or b"").split(b"\n", 1)[0] or b"null")
        except (OSError, ValueError):
            continue
        start = started_at(first) if isinstance(first, dict) else None
        if start is not None and start >= since - 1 and (first.get("payload") or {}).get("cwd") == str(cwd):
            fresh.append((start, str(path)))
    if not fresh:
        return None
    if folder is None:
        return Path(min(fresh)[1])
    root = folder.parent
    with open(root / ".claims.lock", "a") as lock:  # two runs starting together don't take the same one
        fcntl.flock(lock, fcntl.LOCK_EX)
        taken = claimed_rollouts(root, folder)
        for _start, path in sorted(fresh):
            if path not in taken:
                (folder / ".claim").write_text(path)
                return Path(path)
    return None


def write_all(fd: int, data: bytes) -> bool:
    while data:
        try:
            done = os.write(fd, data)
        except OSError:
            return False  # neo closed its end: nothing more to copy to
        data = data[done:]
    return True


def mirror(fd: int, find, stop: threading.Event, seconds: float = MIRROR_SECONDS,
           limit: int = MIRROR_MAX, chunk_size: int = MIRROR_CHUNK) -> None:
    """Copy the transcript find() names onto fd as it grows, byte for byte (neo's offsets are file
    offsets), in bounded reads and at most limit bytes in all, until stop is set; one last copy after
    that, so the final turn is not lost. Only a regular file is copied."""
    path, offset = None, 0
    try:
        while True:
            last = stop.is_set()
            if path is None:
                path = find()
            while path is not None and offset < limit:
                chunk = read_regular(path, offset, min(chunk_size, limit - offset))
                if not chunk:
                    break
                if not write_all(fd, chunk):
                    return
                offset += len(chunk)
            if last or offset >= limit:
                return
            stop.wait(seconds)
    finally:
        try:
            os.close(fd)
        except OSError:
            pass


def fd_spec(spec: dict, key: str, taken: set):
    """An fd number neo passed in the spec (mirror, log), checked: open, not 0-2, not one already used."""
    fd = spec.get(key)
    if not isinstance(fd, int) or isinstance(fd, bool) or fd < 3 or fd in taken:
        fail(f"bad {key} in spec")
    try:
        os.fstat(fd)
    except OSError:
        fail(f"{key} {fd} is not open")
    return fd


def mirror_spec(spec: dict, spec_fd: int):
    """(fd, engine, session id) from the spec's mirror, or None; refuses fds neo-run itself uses."""
    given = spec.get("mirror")
    if not isinstance(given, dict):
        return None
    engine, session_id = str(given.get("engine") or ""), str(given.get("session_id") or "")
    if engine not in ENGINES:
        fail("bad mirror in spec")
    if session_id and not SESSION_RE.match(session_id):
        fail("bad session id in mirror")
    taken = {spec_fd, LOG[0]} if LOG else {spec_fd}
    return fd_spec(given, "fd", taken), engine, session_id


def not_dumpable() -> None:
    """Nothing of this account may read our memory or open our fds (the spec, neo's mirror file) through
    /proc; the engine we start is dumpable again, as any program it runs."""
    try:
        import ctypes
        ctypes.CDLL(None, use_errno=True).prctl(4, 0, 0, 0, 0)  # PR_SET_DUMPABLE, 0
    except (OSError, AttributeError):
        pass


def terminal_fd():
    for fd in (0, 1, 2):
        try:
            if os.isatty(fd):
                return fd
        except OSError:
            continue
    return None


def give_terminal(fd, pgid: int) -> None:
    """Make pgid the terminal's foreground group (SIGTTOU held off: we may be in the background)."""
    if fd is None:
        return
    old = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGTTOU})
    try:
        os.tcsetpgrp(fd, pgid)
    except OSError:
        pass
    finally:
        signal.pthread_sigmask(signal.SIG_SETMASK, old)


FILE_RE = re.compile(r"\{file:([A-Za-z0-9_.-]+)\}")


def fill(argv: list, paths: dict) -> list:
    """Replace each {file:NAME} (a whole argument or inside one, e.g. the hook command in --settings)."""
    def path(match: "re.Match") -> str:
        if match.group(1) not in paths:
            fail(f"argv names a file the spec doesn't carry: {match.group(1)}")
        return paths[match.group(1)]

    return [FILE_RE.sub(path, str(arg)) for arg in argv]


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--spec-fd", type=int, required=True)
    args = parser.parse_args()
    not_dumpable()
    os.umask(0o077)
    home = account_home()
    spec = read_spec(args.spec_fd)
    if "log_fd" in spec:  # a live agent's pane: our own messages also go where neo can show them
        LOG.append(fd_spec(spec, "log_fd", {args.spec_fd}))
    tty = spec.get("tty") is True
    mirrored = mirror_spec(spec, args.spec_fd)
    (home / "code").mkdir(exist_ok=True, mode=0o700)
    tmp = home / ".cache" / "tmp"  # their own, not the /tmp every account shares
    tmp.mkdir(parents=True, exist_ok=True, mode=0o700)
    cwd = resolve_cwd(home, spec.get("cwd") or "")
    if not cwd.is_dir():
        fail(f"no such folder: {cwd}")
    env = {"HOME": str(home), "USER": home.name, "LOGNAME": home.name, "PATH": PATH,
           "LANG": "C.UTF-8", "TMPDIR": str(tmp), **(tty_env() if tty else {}), **clean_env(spec.get("env"))}
    logins, used = login_env(home, spec.get("shared"))
    env.update(logins)
    env.update(token_env(spec.get("tokens")))
    env.update(git_identity_env(home, str(spec.get("git_name") or ""), str(spec.get("git_email") or "")))
    run_id = str((spec.get("env") or {}).get("NEO_RUN_ID") or os.getpid())
    folder, paths = write_files(home, run_id, spec.get("files"))
    argv = fill(spec["argv"], paths)
    argv[0] = engine_path(os.path.basename(argv[0]), argv[1:])  # neo's path to it may differ; use this machine's
    if tty and os.path.basename(argv[0]) == "claude":
        prepare_live_claude(home)
    say(f"{home.name} in {cwd}; logins " + " ".join(f"{k}={v}" for k, v in used.items()))

    # Handlers before the engine starts: a stop that lands in between must still reach it.
    child: list = []
    stopping: list = []

    def stop(signum, _frame=None):
        stopping.append(signum)
        if child:
            try:
                os.killpg(child[0].pid, signum)  # the engine's whole group: its MCP servers and shells too
            except ProcessLookupError:
                pass
            signal.alarm(KILL_AFTER)  # still there by then: SIGKILL (neo can't signal this account itself)

    def kill(_signum, _frame):
        try:
            os.killpg(child[0].pid, signal.SIGKILL)
        except (ProcessLookupError, IndexError):
            pass

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, stop)
    signal.signal(signal.SIGALRM, kill)
    # tty: the engine gets its own process group and the terminal (keys, resizes, Ctrl-C go to it alone,
    # and herdr sees it as the pane's foreground job); a stop reaches the whole group. Otherwise: its own
    # session, away from any terminal.
    term = terminal_fd() if tty else None

    def take_terminal() -> None:  # in the engine, before it runs: it must never read as a background job
        give_terminal(term, os.getpgrp())

    copied, copying = threading.Event(), None
    try:
        started = time.time()
        if tty:
            child.append(subprocess.Popen(argv, cwd=str(cwd), env=env, process_group=0, preexec_fn=take_terminal))
            give_terminal(term, child[0].pid)
        else:
            child.append(subprocess.Popen(argv, cwd=str(cwd), env=env, start_new_session=True))
        if mirrored:
            fd, engine, session_id = mirrored
            find = lambda: find_transcript(home, engine, session_id, cwd, started, folder)  # noqa: E731
            copying = threading.Thread(target=mirror, daemon=True, args=(fd, find, copied))
            copying.start()
        if stopping:
            stop(stopping[-1])
        code = child[0].wait()
    finally:
        if tty:
            give_terminal(term, os.getpgrp())
        copied.set()
        if copying:
            copying.join(timeout=5)
        shutil.rmtree(folder, ignore_errors=True)
    return code if code >= 0 else 128 - code


if __name__ == "__main__":
    sys.exit(main())
